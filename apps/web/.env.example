# Base URL the browser calls for the ReturnFlow API (no trailing slash).
#
# - Local development: leave this unset (or commented out, as below). The
#   app defaults to the relative path "/api/v1", which the Vite dev server
#   proxies to http://localhost:8080 (see vite.config.ts) — no backend CORS
#   change needed.
# - Deployment (web and API on different origins, e.g. Cloudflare Pages +
#   Railway): set this to the API's own origin plus "/api/v1", e.g.
#   https://api.returnflow.example.com/api/v1.
# VITE_API_BASE_URL=http://localhost:8080/api/v1
