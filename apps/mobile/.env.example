# Base URL of the ReturnFlow API (no trailing slash).
#
# - Web/Android emulator/iOS simulator running on the same machine as the
#   API: http://localhost:8080 works.
# - A physical phone (Expo Go) cannot reach the laptop through "localhost" —
#   that resolves to the phone itself. Use the laptop's local-network IP
#   instead (e.g. http://192.168.1.23:8080), found via `ipconfig` (Windows)
#   or `ifconfig`/`ip addr` (macOS/Linux). The phone and laptop must be on
#   the same Wi-Fi network, and the API must already be running.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_COMPUTER_LAN_IP:8080
