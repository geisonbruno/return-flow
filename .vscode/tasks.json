{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ReturnFlow: Start Infrastructure",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml up -d",
      "problemMatcher": []
    },
    {
      "label": "ReturnFlow: Stop Infrastructure",
      "type": "shell",
      "command": "docker compose -f infra/docker-compose.yml down",
      "problemMatcher": []
    },
    {
      "label": "ReturnFlow: Run API",
      "type": "shell",
      "command": ".\\mvnw.cmd spring-boot:run \"-Dspring-boot.run.profiles=local\"",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "problemMatcher": []
    },
    {
      "label": "ReturnFlow: Run API Tests",
      "type": "shell",
      "command": ".\\mvnw.cmd test",
      "options": { "cwd": "${workspaceFolder}/apps/api" },
      "problemMatcher": []
    },
    {
      "label": "ReturnFlow: Run Web",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "problemMatcher": []
    },
    {
      "label": "ReturnFlow: Run Web Tests",
      "type": "shell",
      "command": "npm run test",
      "options": { "cwd": "${workspaceFolder}/apps/web" },
      "problemMatcher": []
    },
    {
      "label": "ReturnFlow: Run Mobile",
      "type": "shell",
      "command": "npx expo start",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "problemMatcher": []
    },
    {
      "label": "ReturnFlow: Run Mobile Tests",
      "type": "shell",
      "command": "npm run test",
      "options": { "cwd": "${workspaceFolder}/apps/mobile" },
      "problemMatcher": []
    }
  ]
}
